<h1><%= @chat_room.display_name_for(current_user) %></h1>

<div id = 'messages' data-room-id='<%= @chat_room.id %>'>
  <% @messages.each do |message| %>
    <%= render partial: 'messages/message', locals: { message: message } %>
  <% end %>
</div>

<%= form_with model: [@chat_room, @message], id: 'message-form' do |form| %>
  <div>
    <%= form.text_area :body, placeholder: 'メッセージを入力してください' %>
  </div>
  <%= form.submit '送信' %>
  
  <% if @message.errors.any? %>
    <ul>
      <% @message.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<%= paginate @messages %>