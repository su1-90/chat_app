<%# CSSでグループ名をクリックしたら表示されるという動きにする %>
<% @chat_room.users.each do |user| %>
  <p>
    <%= user.username %>
  </p>
<% end %>

<h1><%= @chat_room.display_name_for(current_user) %></h1>

<%= turbo_stream_from @chat_room %>

<div id = 'messages' >
  <% @messages.each do |message| %>
    <%= render 'messages/message', message: message, viewer: current_user %>
  <% end %>
</div>

<div id='message_form' >
  <%= render 'messages/form', chat_room: @chat_room, message: @message %>
</div>

<%= paginate @messages %>