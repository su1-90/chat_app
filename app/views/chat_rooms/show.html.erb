<h1><%= @chat_room.display_name_for(current_user) %></h1>

<div id = 'messages'>
  <% @messages.each do |message| %>
    <% mine = (message.user_id == current_user.id) %>

    <div class="<%= mine ? 'msg msg--mine' : 'msg msg--theirs' %>">
      <div class="msg_meta">
        <%= message.user.username.presence || message.user.email %>
      </div>
      <div class="msg_body">
        <%= message.body %>
      </div>
    </div>
  <% end %>
</div>

<%# 後で非同期に変更する %>
<%= form_with model: [@chat_room, @message] do |form| %>
  <div>
    <%= form.text_area :body, placeholder: 'メッセージを入力してください' %>
  </div>
  <%= form.submit '送信' %>
  
  <% if @message.errors.any? %>
    <ul>
      <% @message.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<%= paginate @messages %>